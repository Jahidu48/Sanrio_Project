# ==========================================================
# Sanrio Couple Space PWA - Environment Variables
# Copy this file to .env.local and fill in your credentials
# ==========================================================

# 1. Supabase Configuration (Realtime Broadcast, Presence & Postgres)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Default shared room ID for the couple
NEXT_PUBLIC_COUPLE_ROOM_ID=couple-room

# 2. Google Gemini API Key (Used in /api/generate-journal via @google/genai)
GEMINI_API_KEY=your-gemini-api-key
